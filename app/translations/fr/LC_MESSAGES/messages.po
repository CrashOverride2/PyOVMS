msgid "(days to keep)."
msgstr "(durée de conservation en jours)."

#: app/templates/edit_user.html
#, python-format
msgid ""
"12 to 128 characters long. Include uppercase, lowercase, a digit, and a special "
"character (e.g., !@#$%%^&*)."
msgstr ""
"12 à 128 caractères. Incluez des majuscules, des minuscules, un chiffre et un "
"caractère spécial (p. ex., !@#$%%^&*)."

