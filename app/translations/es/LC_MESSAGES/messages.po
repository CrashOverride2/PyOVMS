#: app/templates/email/admin_lifecycle_account.txt
msgid ""
"An account deletion warning has been sent to a user because their account has no "
"vehicles and they have not logged in for more than 30 days."
msgstr ""
"Se ha enviado una advertencia de eliminación de cuenta a un usuario, ya que su cuenta"
" no tiene vehículos y no ha iniciado sesión desde hace más de 30 días."

#: app/templates/email/admin_lifecycle_account.html
msgid ""
"An account deletion warning has been sent to a user because their account has no "
"vehicles and they have not logged in for more than 30 days. The account will be "
"automatically deleted in 7 days unless the user takes action."
msgstr ""
"Se ha enviado una advertencia de eliminación de cuenta a un usuario porque su cuenta "
"no tiene vehículos y no ha iniciado sesión durante más de 30 días. La cuenta se "
"eliminará automáticamente en 7 días a menos que el usuario actúe."

# than
#: app/templates/email/admin_lifecycle_vehicle.txt
msgid ""
"An inactivity warning email has been sent to a vehicle owner because their vehicle "
"has not communicated for more than 12 months."
msgstr ""
"Se ha enviado un aviso de inactividad por correo electrónico al propietario de un "
"vehículo, ya que su vehículo no ha comunicado desde hace más de 12 meses."

#: app/templates/email/admin_lifecycle_vehicle.html
msgid ""
"An inactivity warning email has been sent to a vehicle owner because their vehicle "
"has not communicated with the server for more than 12 months. The vehicle will be "
"automatically deleted in 7 days if no communication is received."
msgstr ""
"Se ha enviado un correo de advertencia de inactividad a un propietario de vehículo "
"porque su vehículo no ha comunicado con el servidor durante más de 12 meses. El "
"vehículo se eliminará automáticamente en 7 días si no se recibe ninguna comunicación."

