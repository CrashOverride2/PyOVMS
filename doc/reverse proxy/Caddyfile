# /etc/caddy/Caddyfile
#
# Replace "your.domain.com" with your actual domain. Caddy obtains and renews
# a TLS certificate via Let's Encrypt automatically — no Certbot step needed.
# Optional service blocks are commented out — uncomment the ones that match
# your setup.

your.domain.com {

    # Security headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options "nosniff"
        -Server
    }

    # ── Valhalla routing (optional) ─────────────────────────────────────────
    # Requires: docker compose up -d valhalla (binds to 127.0.0.1:8002).
    # forward_auth makes a subrequest to PyOVMS to validate the X-API-Key
    # before the request is allowed to reach Valhalla.
    #
    # @valhalla path /route /route/*
    # handle @valhalla {
    #     forward_auth 127.0.0.1:8000 {
    #         uri /api/v1/auth/ping
    #         copy_headers X-API-Key
    #     }
    #     reverse_proxy 127.0.0.1:8002
    # }

    # ── Karto trip tracking API (optional) ──────────────────────────────────
    # Requires: ENABLE_KARTO_TRIP_TRACKING=true in .env (runs on port 8001).
    #
    # handle /api/karto* {
    #     reverse_proxy 127.0.0.1:8001
    # }

    # ── Protomaps tile server (optional) ────────────────────────────────────
    # Serves local .pmtiles files. Range-request headers are required by
    # Protomaps clients for efficient tile delivery.
    #
    # handle /maps/* {
    #     root * /opt/PyOVMS-Karto/maps
    #     file_server
    #     header Access-Control-Allow-Origin "*"
    #     header Cache-Control "no-store"
    #     header Accept-Ranges "bytes"
    #     header Vary "Range"
    # }

    # ── Main PyOVMS application ──────────────────────────────────────────────
    reverse_proxy 127.0.0.1:8000

    # ── Custom error pages ───────────────────────────────────────────────────
    handle_errors {
        @404 expression {http.error.status_code} == 404
        @429 expression {http.error.status_code} == 429
        @502 expression {http.error.status_code} == 502
        @504 expression {http.error.status_code} == 504

        handle @404 {
            root * /var/www/html
            rewrite * /404.html
            file_server
        }
        handle @429 {
            root * /var/www/html
            rewrite * /429.html
            file_server
        }
        handle @502 {
            root * /var/www/html
            rewrite * /502.html
            file_server
        }
        handle @504 {
            root * /var/www/html
            rewrite * /504.html
            file_server
        }
    }

    log {
        output file /var/log/caddy/pyovms-access.log
    }
}
