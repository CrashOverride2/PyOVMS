# -----------------------------------------------------------------------------
# PyOVMS Environment Configuration Template
#
# Copy this file to .env and edit the values below.
# Lines starting with # are comments.
# Commented-out variables will use their default values from the application.
# -----------------------------------------------------------------------------

# --- DATABASE CONFIGURATION ---
# The connection URL for your database.
# Default is an SQLite file in the project root.
DATABASE_URL="sqlite:///./ovms_py.db"
# Example for PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:port/dbname"
# Example for MySQL:
# DATABASE_URL="mysql+pymysql://user:password@host:port/dbname"

# Connection pooling. Ignored for SQLite. The defaults suit a single server with a
# handful of vehicles; the numbers below matter once you point this at PostgreSQL.
#
# If Karto shares the same database server, the limit that counts is both services
# together: (DB_POOL_SIZE + DB_MAX_OVERFLOW) x 2 must stay well under the server's
# max_connections (PostgreSQL defaults to 100).
#
# DB_POOL_SIZE=10             # connections kept open
# DB_MAX_OVERFLOW=10          # extra connections allowed during a burst
# DB_POOL_TIMEOUT_SECONDS=30  # how long a request waits for a free connection before
#                             # failing. Do not raise this to hide an overloaded
#                             # database — the TCP listeners share this event loop.


# --- GENERAL SERVER SETTINGS ---
# The IP address the server will listen on. 0.0.0.0 makes it accessible on all network interfaces.
SERVER_HOST="0.0.0.0"
# The port for the HTTP Web UI and API.
HTTP_PORT=8000
# The port for the plain text V2 TCP protocol.
TCP_PORT=6867
# The port for the encrypted V2 TCP protocol (requires SSL cert/key below).
TCP_SSL_PORT=6870
# The public-facing base URL of the server. Required for generating correct email verification links.
SERVER_BASE_URL="http://localhost:8000"


# --- SECURITY & AUTHENTICATION ---
# ⚠️  IMPORTANT: These keys are critical for security!
#
# 🔐 RECOMMENDED: Use the auto-generation script to create secure secrets:
#    python generate_secrets.py
#
# This will automatically generate all required secrets and create your .env file.
#
# If you prefer manual generation:
#   - JWT Secret: openssl rand -base64 64
#   - TOTP Key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   - MQTT Passwords: openssl rand -base64 32
#
# ❌ DO NOT use these default values in production - they are placeholders only!
# Signs CSRF tokens only. Session tokens use the Ed25519 key pair below.
SECRET_KEY_JWT="another_super_secret_key_for_jwt_change_this_for_production"

# -- Session token signing (Ed25519) --
# Generated by run.py on first start; regenerate manually with:
#   python -m app.jwt_keys
# Both values are base64 of the raw 32-byte key. They must belong together — the server
# refuses to start on a mismatched pair.
#
# JWT_PUBLIC_KEY is the ONLY value the Karto service needs. It verifies session cookies
# and must never receive JWT_PRIVATE_KEY: with the previous shared symmetric secret,
# read access to Karto's config was enough to mint a session for any user here.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Secret key used to sign the server-side session cookie (independent of the JWT key).
# Auto-generated by run.py / generate_secrets.py — set it explicitly for multi-instance deployments.
SECRET_KEY_SESSION="another_super_secret_key_for_session_change_this_for_production"
# For encrypting TOTP secrets and other sensitive data at rest
TOTP_ENCRYPTION_KEY="0gXIqS9Z0kZ-Yg7tJ2eX_rU8wH6vI9nL0fA3cE1bS2k=_change_this_strong_random_key"
# Optional secondary encryption key for key rotation (leave commented out unless rotating keys)
#TOTP_ENCRYPTION_KEY_V2=

# -- JWT Token Settings --
# How many minutes JWT access tokens remain valid. 60 minutes is recommended for production.
# The UI uses cookie-based sessions with rolling expiry; this controls the JWT lifetime.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -- Cookie Security --
# Force secure cookies even when HTTPS is not detected (useful for reverse proxy setups)
FORCE_SECURE_COOKIES=True

# NOTE: On the first run with an empty database, an administrator account is created
# automatically. The random username and password will be printed to the server log.
# It is critical to log in with these credentials and change the password immediately.

# -- User Registration & Email Verification --
# Allow new users to register themselves via the web UI. Requires email settings to be configured.
ALLOW_USER_REGISTRATION=False
# Send an email to all active admins when a new user registers.
SEND_ADMIN_REGISTRATION_EMAIL=True
# How many hours a new user's email verification link is valid for.
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
# How many hours a password-reset link remains valid.
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# -- Multi-Factor Authentication (2FA/TOTP) --
# Users can enable TOTP (Time-based One-Time Password) 2FA in their profile settings.
# Requires TOTP_ENCRYPTION_KEY to be set above.
# Rate limiting: 5 failed TOTP attempts = temporary IP block, 10 = permanent account lockout.
# Name displayed in authenticator apps (e.g., "PyOVMS", "My OVMS Server")
OTP_ISSUER_NAME="PyOVMS"

# -- WebAuthn / Passkeys Support --
# Users can register hardware security keys (YubiKey, etc.) or device passkeys
# (Touch ID, Face ID, Windows Hello) for passwordless authentication.
# Configured via user profile settings. Requires HTTPS in production.
# Your domain name without protocol (e.g., "example.com" or "localhost")
WEBAUTHN_RP_ID="localhost"
# Display name for your service shown in browser prompts
WEBAUTHN_RP_NAME="PyOVMS"
# Full origin URL including protocol (e.g., "https://example.com" or "http://localhost:8000")
WEBAUTHN_ORIGIN="http://localhost:8000"
# Comma-separated list of trusted Android APK key-hash origins for the OVMS Android app.
# Required if Android users register passkeys from the native app rather than a browser.
# Format: "android:apk-key-hash:<base64-hash>,android:apk-key-hash:<base64-hash>"
#WEBAUTHN_TRUSTED_ANDROID_ORIGINS=

# -- Security Features --
# Rate limiting and IP blocking are enabled automatically:
# - Login failures: 5 attempts in 60 seconds = 60 minute IP block
# - API key failures: 10 attempts in 60 seconds = 60 minute IP block
# - TOTP failures: 5 attempts = temp block, 10 = permanent lockout
# Security events are logged to the database and visible in /admin/security-events
# When an IP is blocked, all active admins with email addresses receive an alert.

# Maximum number of API keys a single user may hold.
MAX_API_KEYS_PER_USER=50

# Configuration backups of the OVMS Connect app (/api/v1/config-backups): snapshots
# of the app's own settings, stored per user as JSON text. Setting ENABLED=false
# keeps the routes and answers 403; the app then stops offering the feature.
# 'auto' snapshots roll per device (MAX_AUTO, oldest evicted); 'manual' ones are
# pinned and capped (MAX_MANUAL). MAX_DEVICES bounds the devices with an auto
# window per user (the stalest loses its auto snapshots). Sizes are characters
# of JSON text; on the wire that is up to four bytes per character.
CONFIG_BACKUP_ENABLED=true
CONFIG_BACKUP_MAX_AUTO=10
CONFIG_BACKUP_MAX_MANUAL=10
CONFIG_BACKUP_MAX_DEVICES=20
CONFIG_BACKUP_AUTO_COALESCE_MINUTES=360
CONFIG_BACKUP_MIN_AUTO_INTERVAL_SECONDS=60
CONFIG_BACKUP_MAX_PAYLOAD_CHARS=262144
CONFIG_BACKUP_MAX_TOTAL_CHARS_PER_USER=8388608

# -- Reverse Proxy Configuration --
# For running behind a reverse proxy like Nginx or Traefik.
# Set to the IP of your proxy to trust X-Forwarded-* headers. Use '*' to trust all (less secure).
FORWARDED_ALLOW_IPS="127.0.0.1"


# --- V3 PROTOCOL / MQTT INTEGRATION ---
# Hostname or IP of your Mosquitto-compatible MQTT broker.
MQTT_BROKER_HOST="localhost"
# Port for your MQTT broker (non-TLS).
MQTT_BROKER_PORT=1883

# Absolute paths to the password and ACL files that PyOVMS will manage for Mosquitto.
# The user running PyOVMS must have write permissions to these files and their parent directories.
# If these are not set, V3 protocol support will be disabled.
#MQTT_PASSWD_FILE="/etc/mosquitto/passwd"
#MQTT_ACL_FILE="/etc/mosquitto/acl"

# Credentials for the PyOVMS backend's own MQTT clients.
# These users and passwords will be automatically added to the MQTT_PASSWD_FILE.
# ⚠️  IMPORTANT: These will be AUTO-GENERATED by running: python generate_secrets.py
# ❌ DO NOT use these default passwords in production!
MQTT_BACKEND_METRICS_SUB_USER="pyovms_metrics_sub"
MQTT_BACKEND_METRICS_SUB_PASS="changeme_metrics_sub_password"
MQTT_BACKEND_NOTIFY_SUB_USER="pyovms_notify_sub"
MQTT_BACKEND_NOTIFY_SUB_PASS="changeme_notify_sub_password"
MQTT_BACKEND_INTERACTIVE_USER="pyovms_interactive"
MQTT_BACKEND_INTERACTIVE_PASS="changeme_interactive_password"


# --- V2 PROTOCOL COMPATIBILITY ---
# Allow push notification tokens (FCM/APNS) to be registered via the legacy V2 TCP protocol.
# This was standard in the original OVMS server but can be disabled for security.
# It is recommended to manage tokens via the API/UI if possible.
# By default, FCM tokens are allowed from V2 for compatibility with older Android apps,
# while APNS tokens are disallowed as newer iOS apps should use a more secure method.
ALLOW_FCM_TOKEN_FROM_V2=True
ALLOW_APNS_TOKEN_FROM_V2=False


# --- NOTIFICATION SERVICE DEFAULTS ---
# These are global defaults. Most can be overridden on a per-vehicle basis in the UI.

# -- NTFY (ntfy.sh) Push Notifications --
NTFY_SERVER="https://ntfy.sh"
NTFY_DEFAULT_TOPIC="ovms_alerts_python"
# Auth method: "bearer", "basic", "query", or "none"
#NTFY_AUTH_METHOD=
#NTFY_AUTH_TOKEN=
#NTFY_AUTH_USER=
#NTFY_AUTH_PASSWORD=
# Name of the query parameter if auth method is "query". Defaults to "token".
#NTFY_AUTH_QUERY_PARAM_NAME="token"

# -- Email Notifications --
# Required for user registration if ALLOW_USER_REGISTRATION=True.
# Also used for security alerts sent to all active admins (IP blocks, etc.).
#EMAIL_HOST=
#EMAIL_PORT=587
#EMAIL_USE_TLS=True
#EMAIL_USE_SSL=False
#EMAIL_USERNAME=
#EMAIL_PASSWORD=
#EMAIL_SENDER="OVMS Alerts <alerts@example.com>"

# Outbound mail queue. All mail is queued and delivered by these workers, so
# EMAIL_QUEUE_WORKERS is also the maximum number of SMTP connections this server opens
# at once — lower it to 1 if your provider limits concurrent connections. Messages are
# held in memory: a restart drops whatever has not gone out yet.
#EMAIL_QUEUE_WORKERS=2
#EMAIL_QUEUE_MAX_SIZE=1000
#EMAIL_QUEUE_MAX_ATTEMPTS=5

# -- FCM (Android Push Notifications) --
# Path to your Firebase Admin SDK service account JSON key file.
#FCM_CREDENTIALS_PATH=

# -- APNs (Apple Push Notifications) --
# Path to your .p8 private key file from Apple Developer.
#APNS_AUTH_KEY_PATH=
# Your 10-character Key ID.
#APNS_KEY_ID=
# Your 10-character Apple Developer Team ID.
#APNS_TEAM_ID=
# Your app's bundle ID (e.g., com.openvehicles.ios).
#APNS_TOPIC=
# APNs server mode: "production" or "development"
#APNS_SERVER_MODE="production"
# How to deliver notifications to Apple devices.
# "apns" (default): Use Apple's native APNs gateway.
# "fcm": Route notifications through Firebase Cloud Messaging (FCM). Requires FCM to be configured.
APNS_DELIVERY_METHOD="apns"


# --- OPTIONAL INTEGRATIONS ---

# -- Karto Trip Tracking --
# Enable the Karto service for trip logging and statistics. Requires a compatible MQTT broker.
ENABLE_KARTO_TRIP_TRACKING=False
# Credentials for the Karto service's own MQTT client.
# This user will be added to the MQTT password file with read access to necessary metrics.
# ⚠️  AUTO-GENERATED by: python generate_secrets.py
#KARTO_MQTT_USER="karto_service_user"
#KARTO_MQTT_PASSWORD="a_very_strong_mqtt_password_for_karto"

# -- Charge Logging --
# Timeout in seconds after which an active charge session is considered stale/completed if no new metrics are received.
TIMEOUT_CHARGE_IDLE=1800

# -- Protomaps (Self-Hosted Maps) --
# URL to your Protomaps .pmtiles file for self-hosted, offline-capable maps on the trip detail page.
# If commented out, the UI will use OpenStreetMap tiles.
# Example: PROTOMAPS_URL="https://your.domain.com/path/to/map.pmtiles"
#PROTOMAPS_URL=


# --- WEB UI SETTINGS ---
# Target of the "Source Code" link in every page footer. PyOVMS is GPL-3.0: there is no
# network clause, so running a modified copy as a service does not by itself oblige you
# to publish. Point this at your own fork anyway if you changed anything — users of your
# instance have no other way to find the code they are actually talking to.
#SOURCE_CODE_URL="https://github.com/CrashOverride2/PyOVMS"
# Optional footer links. Both stay hidden while unset — set them only if they are YOURS.
#FIRMWARE_REPO_URL="https://firmware.example.com/"
#DONATION_URL="https://example.com/donate"


# --- INTERNATIONALIZATION (I18N) ---
# Default language for the application (e.g., "en", "de").
BABEL_DEFAULT_LOCALE="en"
# Comma-separated list of supported locales for the UI.
#SUPPORTED_LOCALES="en,de,fr,es"
# Path to the directory containing translation files, relative to project root.
BABEL_TRANSLATION_DIRECTORIES="app/translations"


# --- ADVANCED TCP SERVER SETTINGS ---
# SSL certificate and key for the encrypted V2 TCP port (6870).
#SSL_CERT_FILE="cert.pem"
#SSL_KEY_FILE="key.pem"

# Timeouts in seconds.
TIMEOUT_CAR_IDLE=960
TIMEOUT_APP_IDLE=1200
TIMEOUT_TCP_INITIAL_AUTH=60

# How often the idle connection checker runs.
TCP_IDLE_CHECK_INTERVAL=60

# Server-side TCP ping settings to keep connections alive through firewalls/NAT.
# If a car connection is idle and approaching its timeout, the server will send a ping.
TCP_SERVER_PING_INTERVAL=60

# TCP Keepalive settings passed to the OS socket (platform dependent).
TCP_KEEPIDLE=240
TCP_KEEPINTVL=240
TCP_KEEPCNT=9


# --- LOGGING & DEBUGGING ---
# The global logging level for the application.
# Recommended values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# Path to the server log file. If commented out, defaults to 'pyovms_control.log'.
# Set to "" to disable file logging entirely. Required for the admin log viewer.
#LOG_FILE="/var/log/pyovms.log"
# Set to "true" to enable extremely verbose logging of all V2 TCP packets.
# This will significantly impact performance and fill up logs quickly.
DEBUG_TCP_PACKETS=False
# How many days to keep historical data (e.g., status, location logs).
LOG_HISTORY_DAYS=7